# Copy to cockpit.env (git-ignored) and edit. Every value has a safe default; set only what you need.
# --- reach ---------------------------------------------------------------
#GATEWAY_MODE=own                 # own = Istio-served Gateway ; existing = attach to a Gateway you run (e.g. HAProxy)
#GATEWAY_SERVICE_TYPE=LoadBalancer # NodePort if there is no MetalLB
#GATEWAY_LB_IP=10.10.1.60          # fixed MetalLB address
#COCKPIT_HOST=cockpit.apps.corp.example   # only if your Gateway listener requires a hostname
# --- kube-hostfail ---------------------------------------------------------
#HOSTFAIL_MODE=demo               # demo = replay bundled snapshot ; live = read your vCenter
#HOSTFAIL_CLUSTER_NAME=lab
#HOSTFAIL_IMAGE=ghcr.io/willey2003/kube-hostfail:0.1.0
# live mode (read-only vCenter account) - export these in your shell, do not store them here:
#   export VSPHERE_SERVER=vcenter.corp.example VSPHERE_USER='svc-hostfail@vsphere.local' VSPHERE_PASSWORD=...
# --- observability ---------------------------------------------------------
#STORAGE_CLASS=                   # empty = cluster default ; none = emptyDir
#GRAFANA_ANONYMOUS=true           # anonymous Viewer (lab convenience); false = login required
#ETCD_METRICS=false               # scrape external etcd (see README)
#ETCD_ENDPOINTS=10.10.1.12,10.10.1.13,10.10.1.19
